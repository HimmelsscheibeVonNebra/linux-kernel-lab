# Minimal i386 kernel for the v86 emulator.
# Buildroot runs "olddefconfig" on this file, so everything not listed
# here takes its Kconfig default.

# CONFIG_64BIT is not set
CONFIG_LOCALVERSION="-kernellab"
CONFIG_M686=y
# CONFIG_SMP is not set
# CONFIG_CPU_MITIGATIONS is not set
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Logging / introspection used in the exercises
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_FS=y

# Loadable modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Filesystems
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Consoles: VGA text (browser screen) + serial (automated tests)
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y

# Host <-> guest file exchange (v86 9p over virtio)
CONFIG_PCI=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
