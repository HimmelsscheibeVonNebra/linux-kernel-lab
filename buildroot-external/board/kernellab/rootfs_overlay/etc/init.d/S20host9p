#!/bin/sh
# Boot-time mounts for the lab:
#   /mnt/9p     the page's 9p filesystem (files are fetched over HTTP on first
#               use); /opt/gcc and /mnt/host are symlinks into it
#   /dev/mqueue POSIX message queues

case "$1" in
start)
	mount -t 9p -o trans=virtio,version=9p2000.L host9p /mnt/9p 2>/dev/null \
		|| echo "host9p: not available (gcc and file upload disabled)"
	mkdir -p /dev/mqueue
	mount -t mqueue none /dev/mqueue
	;;
stop)
	umount /mnt/9p /dev/mqueue 2>/dev/null
	;;
esac
exit 0
