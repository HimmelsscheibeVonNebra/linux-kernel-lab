# Target: 32-bit x86 (runs inside the v86 emulator)
BR2_i386=y
BR2_x86_i686=y

# Toolchain: Buildroot-built, glibc (same libc as the students' Ubuntu)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# System
BR2_TARGET_GENERIC_HOSTNAME="kernel-lab"
BR2_TARGET_GENERIC_ISSUE="Linux Kernel Lab"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KERNELLAB_PATH)/board/kernellab/rootfs_overlay"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_KERNELLAB_PATH)/board/kernellab/users.txt"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Asia/Seoul"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_KERNELLAB_PATH)/board/kernellab/post-build.sh"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.40"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_KERNELLAB_PATH)/board/kernellab/linux.config"

# Lab content: kernel modules, user-space examples, tools
BR2_PACKAGE_KERNELLAB_MODULES=y
BR2_PACKAGE_SYSPROG_EXAMPLES=y
BR2_PACKAGE_STRACE=y

# Images: gzip-compressed cpio initramfs only
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
